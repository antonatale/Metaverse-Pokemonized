{
  "name": "lotte-tra-amici",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:parity": "playwright test",
    "test:parity:dist": "vite build && PARITY_NEW=file://$PWD/dist/index.html playwright test",
    "test": "vitest run",
    "test:all": "vitest run && playwright test",
    "golden": "tsx tools/golden.mjs",
    "sim": "tsx tools/sim.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
