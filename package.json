{
  "name": "lotte-tra-amici",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:all": "vitest run && playwright test",
    "golden": "tsx tools/golden.mjs",
    "sim": "tsx tools/sim.ts",
    "sim:fun": "tsx tools/sim-fun.ts",
    "build:google-fonts": "tsc --noEmit && vite build --mode google-fonts",
    "test:e2e": "playwright test",
    "test:e2e:dist": "vite build && GAME_URL=file://$PWD/dist/index.html playwright test tests/e2e/playthrough.spec.ts",
    "promo": "tsx tools/promo/make.ts",
    "playtest": "node tools/playtest/report.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.170.0",
    "three": "^0.170.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
