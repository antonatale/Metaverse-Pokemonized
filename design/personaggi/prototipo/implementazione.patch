diff --git a/tests/unit/company.test.ts b/tests/unit/company.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/unit/company.test.ts
@@ -0,0 +1,40 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { ROSTER } from '../../src/data/characters';
+import { morgana } from '../../src/data/maps/morgana';
+import { st } from '../../src/save/story-progress';
+import { companyOpen, decide } from '../../src/story/choices';
+import { epilogue } from '../../src/story/epilogue';
+import { linesNow } from '../../src/story/plot';
+
+beforeEach(() => {
+  st.seen = {}; st.beaten = {}; st.squad = ['antonio']; st.found = {}; st.mons = []; st.dex = {};
+});
+
+describe('the optional evening at Morgana', () => {
+  it('is available to all protagonists after the piazza, and Costanzo never needs to beat his own covo', () => {
+    for (const hero of ROSTER) expect(companyOpen(hero), hero).toBe(hero === 'costanzo');
+    st.beaten.piazza = true;
+    for (const hero of ROSTER) expect(companyOpen(hero), hero).toBe(true);
+  });
+
+  it('does not tell an evening that has not happened, including in an old completed story', () => {
+    st.beaten = { piazza: true, 'tr-mamurra': true };
+    expect(companyOpen('antonio')).toBe(true);
+    expect(epilogue().join(' ')).not.toContain('Da Morgana');
+  });
+
+  it.each([
+    ['ascolto', 'si sono ascoltati', 'tavoli separati'],
+    ['distanza', 'tavoli separati', 'si sono ascoltati']
+  ])('remembers %s after a save round trip, changes both speakers and tells that ending', (option, yes, no) => {
+    st.beaten.piazza = true;
+    const people = morgana.npcs!.filter(n => n.id === 'claudia-morgana' || n.id === 'costanzo-morgana');
+    const before = people.map(n => linesNow(n).join(' '));
+    decide('compagnia', option);
+    st.seen = JSON.parse(JSON.stringify(st.seen));
+    for (const hero of ROSTER) expect(companyOpen(hero), 'must not replay for ' + hero).toBe(false);
+    people.forEach((n, i) => expect(linesNow(n).join(' '), n.id).not.toBe(before[i]));
+    expect(epilogue().join(' ')).toContain(yes);
+    expect(epilogue().join(' ')).not.toContain(no);
+  });
+});
